# Optional. Without it, WickedAPI tools fall back to x402 pay-per-call —
# calls return a 402 with real payment instructions instead of data.
# With it, WickedAPI tools use the free-tier x-api-key header instead.
# Get one at https://api.wickedapi.com.
WICKEDAPI_API_KEY=

# Optional. Same pattern as WICKEDAPI_API_KEY, for the paid Wicked Registry
# tools (registry_search_tools, registry_tool_detail). Without it they fall
# back to x402. Get one at https://registry.wickedapi.com.
REGISTRY_API_KEY=

# Optional. Same pattern, for the paid Wicked Identity tool (identity_status).
# Without it, it falls back to x402. Get one at https://verify.wickedapi.com.
IDENTITY_API_KEY=

# Optional. Same pattern, for the paid Wicked Sanity tools (sanity_check,
# sanity_check_batch). Without it, they fall back to x402. Sanity keys are
# issued by the operator -- there is no self-serve signup yet.
SANITY_API_KEY=

# Optional. Same pattern, for memory_search (the only metered Wicked Memory
# call). Without it, it falls back to x402. Keys are issued by the operator.
MEMORY_API_KEY=

# Override only for local/staging testing against a different deployment.
MEMORY_BASE_URL=https://memory.wickedapi.com
WICKEDAPI_BASE_URL=https://api.wickedapi.com
REPUTATION_BASE_URL=https://stake.wickedapi.com
REGISTRY_BASE_URL=https://registry.wickedapi.com
IDENTITY_BASE_URL=https://verify.wickedapi.com
SANITY_BASE_URL=https://sanity.wickedapi.com

# HTTP deployment only (dist/http.js) — ignored when run locally over stdio.
RATE_LIMIT_PER_MINUTE=30

# Optional. Bearer key returned once by paywall_signup; needed for paywall_* tools.
PAYWALL_API_KEY=
PAYWALL_BASE_URL=https://paywall.wickedapi.com

# HTTP deployment only. Comma-separated Host allowlist and the header that carries the real client IP.
ALLOWED_HOSTS=mcp.wickedapi.com,wicked-mcp-production.up.railway.app
TRUSTED_CLIENT_IP_HEADER=x-real-ip
